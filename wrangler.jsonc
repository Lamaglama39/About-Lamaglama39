/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "about-lamaglama39",
	"compatibility_date": "2025-04-04",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "about-lamaglama39-blog-cache",
			"id": "<KV_NAMESPACE_ID>"
		}
	],
	"triggers": {
		"crons": [
			"0 */12 * * *"
		]
	},
	"routes": [
		{
			"pattern": "about.lamaglama39.dev",
			"custom_domain": true
		}
	],
}